# ============================================================
# Omnikon Website — environment variables
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` — it is gitignored.
# ============================================================

# --- Firebase Web config (PUBLIC BY DESIGN) ---
# Firebase web API keys are public identifiers, not secrets: the browser
# needs them to use Firebase Auth. Security comes from Firestore rules,
# not from hiding these. They are emitted to public/env-public.json.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Supabase (anon key is PUBLIC BY DESIGN) ---
# The anon key is meant to be embedded in clients; Supabase Row Level
# Security protects the data. Also emitted to public/env-public.json.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- SECRETS — server-side ONLY ---
# Consumed exclusively by Vercel serverless functions in api/.
# NEVER emitted to public/env-public.json; NEVER referenced in client code.

# HuggingFace inference token — used by api/chat.js (chatbot proxy).
HF_TOKEN=

# Blog admin secret — validated by api/blog-insert.js, never client-side.
ADMIN_SECRET=

# --- CI-only secret ---
# GitHub Personal Access Token with repo read access, used by
# .github/workflows/update_projects.yml to refresh github_summary.json.
# Not used by the website at runtime.
GIT_OMNIKON_ALL=
