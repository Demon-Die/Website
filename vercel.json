{
  "rewrites": [
    {
      "source": "/omnikon-ref-:id",
      "destination": "/pages/r.html?id=:id"
    },
    {
      "source": "/",
      "destination": "/pages/index.html"
    },
    {
      "source": "/blog/:article.html",
      "destination": "/pages/blog/:article.html"
    },
    {
      "source": "/:page.html",
      "destination": "/pages/:page.html"
    }
  ]
}
